# ============================================================================
# Learning Platform - Environment Variables (EXAMPLE / template)
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored
# and must NEVER be committed. In production, set these same variables in the
# Render dashboard (Environment) instead of a file.
#
# Do NOT paste secret values into chat or commit them anywhere.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-only secret. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Payments (provider-neutral; Paddle first) ───────────────────────────────
PAYMENT_PROVIDER=paddle
# Paddle Dashboard -> Developer Tools
PADDLE_ENV=sandbox                 # 'sandbox' while building, 'production' at go-live
PADDLE_API_KEY=your-paddle-api-key            # secret, server-only
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret   # secret, server-only
PADDLE_CLIENT_TOKEN=your-paddle-client-side-token  # safe for the browser (Paddle.js)

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of the deployed app; used for checkout redirects and webhooks.
# Local dev:
PUBLIC_BASE_URL=http://localhost:3000
# Production example:
# PUBLIC_BASE_URL=https://your-domain.com
